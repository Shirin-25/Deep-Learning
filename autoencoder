# Import required libraries
import numpy as np
import matplotlib.pyplot as plt

from keras.datasets import mnist
from keras.models import Sequential
from keras.layers import Conv2D, MaxPooling2D, UpSampling2D

# --------------------------------------------------
# 1. Load the MNIST dataset
# --------------------------------------------------

(x_train, _), (x_test, _) = mnist.load_data()

# Normalize pixel values from 0-255 to 0-1
x_train = x_train.astype("float32") / 255.0
x_test = x_test.astype("float32") / 255.0

# Reshape images to (28, 28, 1)
x_train = np.reshape(x_train, (len(x_train), 28, 28, 1))
x_test = np.reshape(x_test, (len(x_test), 28, 28, 1))

print("Training data shape:", x_train.shape)
print("Testing data shape:", x_test.shape)


# --------------------------------------------------
# 2. Designing the Autoencoder Architecture
# --------------------------------------------------

autoencoder = Sequential()

# ---------------- ENCODER ----------------

# First convolution layer
autoencoder.add(
    Conv2D(
        32,
        (3, 3),
        activation="relu",
        padding="same",
        input_shape=(28, 28, 1)
    )
)

# Reduce image size
autoencoder.add(
    MaxPooling2D(
        (2, 2),
        padding="same"
    )
)

# Second convolution layer
autoencoder.add(
    Conv2D(
        16,
        (3, 3),
        activation="relu",
        padding="same"
    )
)

# Reduce image size again
autoencoder.add(
    MaxPooling2D(
        (2, 2),
        padding="same"
    )
)


# ---------------- DECODER ----------------

# First decoder convolution layer
autoencoder.add(
    Conv2D(
        16,
        (3, 3),
        activation="relu",
        padding="same"
    )
)

# Increase image size
autoencoder.add(
    UpSampling2D(
        (2, 2)
    )
)

# Second decoder convolution layer
autoencoder.add(
    Conv2D(
        32,
        (3, 3),
        activation="relu",
        padding="same"
    )
)

# Increase image size again
autoencoder.add(
    UpSampling2D(
        (2, 2)
    )
)

# Final layer - reconstruct original image
autoencoder.add(
    Conv2D(
        1,
        (3, 3),
        activation="sigmoid",
        padding="same"
    )
)


# --------------------------------------------------
# 3. Compile the Model
# --------------------------------------------------

autoencoder.compile(
    optimizer="adam",
    loss="mean_squared_error"
)

# Display model architecture
autoencoder.summary()


# --------------------------------------------------
# 4. Train the Autoencoder
# --------------------------------------------------

autoencoder.fit(
    x_train,
    x_train,
    epochs=50,
    batch_size=256,
    shuffle=True,
    validation_data=(x_test, x_test)
)


# --------------------------------------------------
# 5. Evaluate / Reconstruct Images
# --------------------------------------------------

decoded_imgs = autoencoder.predict(x_test)

print("Reconstructed images shape:", decoded_imgs.shape)


# --------------------------------------------------
# 6. Display Original and Reconstructed Images
# --------------------------------------------------

n = 10

plt.figure(figsize=(20, 4))

# Original images
for i in range(n):
    ax = plt.subplot(2, n, i + 1)
    plt.imshow(x_test[i].reshape(28, 28), cmap="gray")
    plt.axis("off")

# Reconstructed images
for i in range(n):
    ax = plt.subplot(2, n, i + 1 + n)
    plt.imshow(decoded_imgs[i].reshape(28, 28), cmap="gray")

